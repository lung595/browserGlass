window-rule {
    match app-id=r#"^org\.example\.app$"#
    opacity 0.5
}
window-rule {
    match app-id="org.example.browser"
    exclude title="Private"
    opacity 0.55
}
window-rule {
    match is-floating=true
    match app-id="{ // /* not a comment */ }"
    opacity 0.6
}
window-rule {
    geometry-corner-radius 8
}
window-rule {
    opacity 0.9
}
