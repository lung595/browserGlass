{
  "manifest_version": 2,
  "name": "Browser Glass companion",
  "version": "1.4.3",
  "description": "Applies the Browser Glass site exclusions at once, darkens light pages under a dark theme (Dark Reader engine) and tells the DMS launcher which site is open. Talks only to the local Browser Glass helper.",
  "browser_specific_settings": {
    "gecko": {
      "id": "browserglass@companion",
      "strict_min_version": "117.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "nativeMessaging",
    "tabs",
    "storage",
    "*://*/*"
  ],
  "incognito": "not_allowed",
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "frame.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "vendor/darkreader.js",
        "theme.js",
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}