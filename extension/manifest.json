{
  "manifest_version": 2,
  "name": "Browser Glass companion",
  "version": "1.1.0",
  "description": "Applies the Browser Glass site exclusions at once and tells the DMS launcher which site is open. Talks only to the local Browser Glass helper.",
  "browser_specific_settings": {
    "gecko": {
      "id": "browserglass@companion",
      "strict_min_version": "117.0"
    }
  },
  "permissions": ["nativeMessaging", "tabs", "storage", "*://*/*"],
  "incognito": "not_allowed",
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
